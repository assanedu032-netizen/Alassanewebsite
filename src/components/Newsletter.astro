---
interface Props {
  /** Variante d'affichage : 'footer' (compact) ou 'section' (large, fond crème). */
  variant?: 'footer' | 'section';
  title?: string;
  subtitle?: string;
}

const {
  variant = 'section',
  title = 'Reçois mes conseils sur la détente verticale.',
  subtitle,
} = Astro.props;

const isFooter = variant === 'footer';
---

{
  variant === 'section' ? (
    <section class="bg-cream py-16">
      <div class="container-site max-w-2xl text-center">
        <p class="eyebrow">Newsletter</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">{title}</h2>
        {subtitle && <p class="mt-3 text-navy/70">{subtitle}</p>}
        {/* TODO: intégration Brevo/Mailchimp. Pour l'instant, capture via Netlify Forms. */}
        <form
          name="newsletter"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          class="mt-8 flex flex-col gap-3 sm:flex-row"
        >
          <input type="hidden" name="form-name" value="newsletter" />
          <p class="hidden">
            <label>
              Ne pas remplir : <input name="bot-field" />
            </label>
          </p>
          <label class="sr-only" for="newsletter-email-section">Adresse email</label>
          <input
            id="newsletter-email-section"
            type="email"
            name="email"
            required
            placeholder="ton@email.com"
            class="flex-1 rounded-full border border-navy/15 bg-white px-5 py-3 text-navy placeholder:text-navy/40 focus:border-gold focus:outline-none"
          />
          <button type="submit" class="btn-gold whitespace-nowrap">
            S'inscrire
          </button>
        </form>
        <p class="mt-3 text-xs text-navy/50">
          Pas de spam. Désinscription en un clic.
        </p>
      </div>
    </section>
  ) : (
    <div>
      <h3 class="font-[var(--font-heading)] text-lg font-bold text-white">
        Newsletter
      </h3>
      <p class="mt-2 text-sm text-cream/70">
        Mes conseils détente verticale, directement par email.
      </p>
      <form
        name="newsletter"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        class="mt-4 flex flex-col gap-2 sm:flex-row"
      >
        <input type="hidden" name="form-name" value="newsletter" />
        <p class="hidden">
          <label>
            Ne pas remplir : <input name="bot-field" />
          </label>
        </p>
        <label class="sr-only" for="newsletter-email-footer">Adresse email</label>
        <input
          id="newsletter-email-footer"
          type="email"
          name="email"
          required
          placeholder="ton@email.com"
          class="flex-1 rounded-full border border-white/15 bg-navy-light px-4 py-2.5 text-sm text-white placeholder:text-cream/40 focus:border-gold focus:outline-none"
        />
        <button type="submit" class="btn-gold whitespace-nowrap !px-5 !py-2.5 text-sm">
          S'inscrire
        </button>
      </form>
    </div>
  )
}
