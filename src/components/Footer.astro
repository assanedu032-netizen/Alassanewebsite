---
import { NAV_LINKS, SOCIALS, SITE } from '../config/site';
import Newsletter from './Newsletter.astro';
---

<footer class="bg-navy-dark text-cream">
  <div class="container-site grid gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
    <!-- Marque -->
    <div class="lg:col-span-1">
      <a href="/" class="flex items-center gap-1.5 font-[var(--font-heading)] text-xl font-bold italic uppercase tracking-wide">
        <span class="text-white">Alassane</span>
        <span class="text-gold">Coaching</span>
      </a>
      <p class="mt-3 text-sm text-cream/60">{SITE.baseline}</p>
      <div class="mt-5 flex items-center gap-4">
        <a href={SOCIALS.instagram} target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="text-cream/70 transition-colors hover:text-gold">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.86s0 3.6-.07 4.86c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.86.07s-3.6 0-4.86-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.86c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.4 2.2 8.8 2.2 12 2.2Zm0 4.86A4.94 4.94 0 1 0 12 16.94 4.94 4.94 0 0 0 12 7.06Zm0 8.15A3.21 3.21 0 1 1 12 8.8a3.21 3.21 0 0 1 0 6.41Zm6.29-8.35a1.15 1.15 0 1 1-2.3 0 1.15 1.15 0 0 1 2.3 0Z" /></svg>
        </a>
        <a href={SOCIALS.youtube} target="_blank" rel="noopener noreferrer" aria-label="YouTube" class="text-cream/70 transition-colors hover:text-gold">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.5 6.5a3 3 0 0 0-2.11-2.12C19.5 3.86 12 3.86 12 3.86s-7.5 0-9.39.52A3 3 0 0 0 .5 6.5 31.3 31.3 0 0 0 0 12a31.3 31.3 0 0 0 .5 5.5 3 3 0 0 0 2.11 2.12c1.89.52 9.39.52 9.39.52s7.5 0 9.39-.52a3 3 0 0 0 2.11-2.12A31.3 31.3 0 0 0 24 12a31.3 31.3 0 0 0-.5-5.5ZM9.6 15.57V8.43L15.82 12 9.6 15.57Z" /></svg>
        </a>
        <a href={SOCIALS.tiktok} target="_blank" rel="noopener noreferrer" aria-label="TikTok" class="text-cream/70 transition-colors hover:text-gold">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.8a4.3 4.3 0 0 1-1-2.8h-3.1v12.3a2.5 2.5 0 1 1-2.5-2.5c.26 0 .5.04.74.11V9.7a5.6 5.6 0 0 0-.74-.05A5.6 5.6 0 1 0 15.6 15.3V9.04a7.3 7.3 0 0 0 4.4 1.46V7.4a4.3 4.3 0 0 1-3.4-1.6Z" /></svg>
        </a>
      </div>
    </div>

    <!-- Liens rapides -->
    <div>
      <h3 class="font-[var(--font-heading)] text-lg font-bold text-white">Navigation</h3>
      <ul class="mt-4 space-y-2">
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-cream/70 transition-colors hover:text-gold">
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Le livre -->
    <div>
      <h3 class="font-[var(--font-heading)] text-lg font-bold text-white">Le Livre</h3>
      <ul class="mt-4 space-y-2 text-sm text-cream/70">
        <li><a href="/livre" class="transition-colors hover:text-gold">Les Secrets de la Détente Verticale</a></li>
        <li><a href="/application" class="transition-colors hover:text-gold">Athletik Hub</a></li>
        <li><a href="/livre#programmes" class="transition-colors hover:text-gold">Les 6 programmes</a></li>
        <li><a href="/a-propos" class="transition-colors hover:text-gold">À propos d'Alassane</a></li>
      </ul>
    </div>

    <!-- Newsletter -->
    <Newsletter variant="footer" />
  </div>

  <div class="border-t border-white/10">
    <div class="container-site flex flex-col items-center justify-between gap-3 py-5 text-xs text-cream/50 sm:flex-row">
      <p>© 2026 {SITE.name}. Tous droits réservés.</p>
      <div class="flex items-center gap-4">
        <a href="/mentions-legales" class="transition-colors hover:text-gold">Mentions légales</a>
        <a href="/contact" class="transition-colors hover:text-gold">Contact</a>
      </div>
    </div>
  </div>
</footer>
