---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => +b.data.date - +a.data.date,
);

const hasPosts = posts.length > 0;
---

<BaseLayout
  title="Blog détente verticale — Méthodes, exercices et programmes par Alassane Ndiaye"
  description="Des articles concrets sur la détente verticale, l'explosivité et la préparation physique. Basés sur le terrain, pas sur des théories récupérées en ligne."
  appendBrand={false}
  showQuiz={false}
>
  <section class="bg-navy section-padding text-white">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow">Conseils de coach — gratuit</p>
      <h1 class="display-section">Le blog détente verticale.</h1>
      <p class="mt-6 text-lg text-cream/85">
        Des méthodes concrètes, basées sur l'expérience terrain — pas sur des théories
        récupérées en ligne. Tout ce que tu lis ici, j'ai vécu ou testé avec mes 900+ athlètes.
      </p>
    </div>
  </section>

  <!-- Intro coach -->
  <section class="bg-cream py-10">
    <div class="container-site max-w-3xl">
      <blockquote class="border-l-4 border-gold pl-5 text-navy/80 italic">
        J'écris pas pour écrire. J'écris pour que tu comprennes quelque chose que tu peux
        appliquer dès demain. Si tu veux aller plus loin que les articles — le livre et
        Athletik Hub te donnent le système complet.
      </blockquote>
      <p class="mt-4">
        <a href="/livre" class="text-sm font-semibold text-gold-dark underline">Découvrir le livre →</a>
      </p>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="container-site">
      {
        hasPosts ? (
          <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <article class="group flex flex-col overflow-hidden rounded-2xl border border-navy/8 bg-white shadow-sm transition-all duration-300 hover:border-gold hover:shadow-lg hover:-translate-y-1">
                {post.data.cover && (
                  <a href={`/blog/${post.id}`} class="block">
                    <Image
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? post.data.title}
                      class="aspect-video w-full object-cover"
                      widths={[300, 500, 700]}
                      sizes="(max-width: 768px) 100vw, 33vw"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="flex flex-1 flex-col p-7">
                  <div class="flex items-center gap-3 text-xs text-navy/55">
                    <span class="font-semibold uppercase tracking-wide text-gold">
                      {post.data.category}
                    </span>
                    {post.data.readingTime && <span>· {post.data.readingTime}</span>}
                  </div>
                  <h2 class="mt-3 text-lg font-bold text-navy">
                    <a href={`/blog/${post.id}`} class="transition-colors duration-200 hover:text-gold-dark">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="mt-3 flex-1 text-sm leading-relaxed text-navy/70">
                    {post.data.description}
                  </p>
                  <a
                    href={`/blog/${post.id}`}
                    class="mt-5 inline-block text-sm font-semibold text-gold-dark"
                  >
                    Lire l'article →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-2xl font-bold text-navy">Les articles arrivent bientôt.</h2>
            <p class="mt-3 text-navy/70">Reviens vite — du contenu concret se prépare.</p>
            <a href="/livre" class="btn-gold mt-6">Découvrir le livre →</a>
          </div>
        )
      }
    </div>
  </section>

  <!-- CTA bas de page -->
  <section class="bg-cream section-padding">
    <div class="container-site max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-navy sm:text-4xl">
        Les articles, c'est le début. Le livre, c'est le système.
      </h2>
      <p class="mt-5 text-navy/70">
        Ce que tu lis ici, c'est une partie de la méthode. Le livre condense 10 ans de terrain
        et de recherche — science, programmes, application incluse.
      </p>
      <a href="/livre" class="btn-gold mt-8">Découvrir Les Secrets de la Détente Verticale →</a>
    </div>
  </section>
</BaseLayout>
