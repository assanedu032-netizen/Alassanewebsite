---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';

/*
  Page /blog — liste les articles publiés (non-draft) de la collection.
  Structure technique prête depuis le début ; on publie désormais de vrais articles.
*/
const posts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
  (a, b) => +b.data.date - +a.data.date,
);

const hasPosts = posts.length > 0;
---

<BaseLayout
  title="Blog détente verticale, explosivité et préparation physique"
  description="Conseils, exercices et méthodes pour améliorer ta détente verticale, développer ton explosivité et mieux structurer ton entraînement."
  appendBrand={false}
  showQuiz={false}
>
  <section class="bg-navy py-16 text-white">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow">Le blog</p>
      <h1 class="display-section">
        Blog détente verticale, explosivité et préparation physique
      </h1>
      <p class="mt-5 text-lg text-cream/85">
        Des articles concrets, basés sur l'expérience terrain — pas sur des théories
        récupérées en ligne.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container-site">
      {
        hasPosts ? (
          <div class="grid gap-7 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <article class="group flex flex-col overflow-hidden rounded-2xl border border-navy/10 bg-white shadow-sm transition-all hover:border-gold hover:shadow-lg">
                {post.data.cover && (
                  <a href={`/blog/${post.id}`} class="block">
                    <Image
                      src={post.data.cover}
                      alt={post.data.coverAlt ?? post.data.title}
                      class="aspect-video w-full object-cover"
                      widths={[300, 500, 700]}
                      sizes="(max-width: 768px) 100vw, 33vw"
                      loading="lazy"
                    />
                  </a>
                )}
                <div class="flex flex-1 flex-col p-6">
                  <div class="flex items-center gap-3 text-xs text-navy/55">
                    <span class="font-semibold uppercase tracking-wide text-gold">
                      {post.data.category}
                    </span>
                    {post.data.readingTime && <span>· {post.data.readingTime}</span>}
                  </div>
                  <h2 class="mt-2 text-lg font-bold text-navy">
                    <a href={`/blog/${post.id}`} class="hover:text-gold-dark">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-navy/70">
                    {post.data.description}
                  </p>
                  <a
                    href={`/blog/${post.id}`}
                    class="mt-4 inline-block text-sm font-semibold text-gold-dark"
                  >
                    Lire l'article →
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="mx-auto max-w-2xl text-center">
            <h2 class="text-2xl font-bold text-navy">Les articles arrivent bientôt.</h2>
            <p class="mt-3 text-navy/70">Reviens vite — du contenu concret se prépare.</p>
            <a href="/livre" class="btn-gold mt-6">Découvrir le livre →</a>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
