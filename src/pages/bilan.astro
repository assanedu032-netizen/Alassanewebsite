---
import BaseLayout from '../layouts/BaseLayout.astro';

const benefits = [
  {
    title: 'On évalue ton niveau',
    body: 'Détente actuelle, force, explosivité, mobilité : on fait le point sur où tu en es vraiment.',
  },
  {
    title: 'On clarifie tes objectifs',
    body: 'Dunker, gagner de la détente durable, performer : on définit une cible claire et mesurable.',
  },
  {
    title: 'On identifie ton programme',
    body: "Avec ces infos, je t'oriente vers le programme Athletik Hub le plus adapté à ton profil.",
  },
];
---

<BaseLayout
  title="Réserver un bilan athlétique"
  description="Réserve ton bilan athlétique gratuit : on évalue ton niveau et tes objectifs, et j'identifie le programme Athletik Hub le plus adapté à ton profil. Sans engagement."
>
  <!-- ===================== HERO ===================== -->
  <section class="bg-navy py-16 text-white">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow">Gratuit · sans engagement</p>
      <h1 class="display-section">Réserve ton bilan athlétique</h1>
      <p class="mt-5 text-lg text-cream/85">
        Tu ne sais pas par où commencer, ni quel programme est fait pour toi ?
        On en parle. J'évalue ton profil et je t'oriente vers le bon plan.
      </p>
    </div>
  </section>

  <!-- ===================== CE QUE TU OBTIENS ===================== -->
  <section class="bg-cream py-16">
    <div class="container-site">
      <div class="grid gap-6 md:grid-cols-3">
        {
          benefits.map((b, i) => (
            <div class="rounded-2xl border border-navy/10 bg-white p-7 shadow-sm">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-navy font-[var(--font-heading)] text-lg italic text-gold">
                {i + 1}
              </span>
              <h2 class="mt-5 text-xl font-bold text-navy">{b.title}</h2>
              <p class="mt-3 text-sm leading-relaxed text-navy/70">{b.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== FORMULAIRE DE RÉSERVATION ===================== -->
  <section class="bg-white py-16">
    <div class="container-site max-w-2xl">
      <!-- Message de confirmation (affiché côté client après redirection Netlify). -->
      <div id="bilan-success" hidden class="mb-6 rounded-xl border border-gold/50 bg-cream p-5">
        <p class="font-semibold text-navy">Demande envoyée ✅</p>
        <p class="mt-1 text-sm text-navy/70">
          Je reviens vers toi sous 24-48h pour caler ton bilan athlétique.
        </p>
      </div>
      <script is:inline>
        if (new URLSearchParams(window.location.search).get('success') === 'true') {
          const el = document.getElementById('bilan-success');
          if (el) {
            el.hidden = false;
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      </script>

      <h2 class="text-2xl font-bold text-navy sm:text-3xl">Tes informations</h2>
      <p class="mt-2 text-sm text-navy/70">
        Réponds en 1 minute, je te recontacte pour fixer le créneau.
      </p>

      <!-- Formulaire Netlify Forms (nom unique « bilan » + honeypot anti-spam). -->
      <form
        name="bilan"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/bilan?success=true"
        class="mt-8 space-y-5"
      >
        <input type="hidden" name="form-name" value="bilan" />
        <p class="hidden">
          <label>Ne pas remplir si tu es humain : <input name="bot-field" /></label>
        </p>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="prenom" class="mb-1.5 block text-sm font-medium text-navy">Prénom</label>
            <input
              id="prenom"
              name="prenom"
              type="text"
              required
              class="w-full rounded-lg border border-navy/15 px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
            />
          </div>
          <div>
            <label for="email" class="mb-1.5 block text-sm font-medium text-navy">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full rounded-lg border border-navy/15 px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
            />
          </div>
        </div>

        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="niveau" class="mb-1.5 block text-sm font-medium text-navy">Ton niveau</label>
            <select
              id="niveau"
              name="niveau"
              required
              class="w-full rounded-lg border border-navy/15 bg-white px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
            >
              <option value="Débutant">Je débute</option>
              <option value="Intermédiaire">J'ai déjà de l'expérience</option>
              <option value="Confirmé">Je suis confirmé</option>
            </select>
          </div>
          <div>
            <label for="objectif" class="mb-1.5 block text-sm font-medium text-navy">Objectif principal</label>
            <select
              id="objectif"
              name="objectif"
              required
              class="w-full rounded-lg border border-navy/15 bg-white px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
            >
              <option value="Dunker">Dunker</option>
              <option value="Détente durable">Gagner une détente durable</option>
              <option value="Puissance / explosivité">Puissance / explosivité max</option>
              <option value="Bien démarrer">Bien démarrer sans me blesser</option>
            </select>
          </div>
        </div>

        <div>
          <label for="dispos" class="mb-1.5 block text-sm font-medium text-navy">Tes disponibilités</label>
          <input
            id="dispos"
            name="dispos"
            type="text"
            placeholder="Ex. en semaine après 18h, le week-end…"
            class="w-full rounded-lg border border-navy/15 px-4 py-2.5 text-navy placeholder:text-navy/40 focus:border-gold focus:outline-none"
          />
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-sm font-medium text-navy">
            Un mot sur ta situation <span class="text-navy/40">(optionnel)</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="w-full rounded-lg border border-navy/15 px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
          ></textarea>
        </div>

        <button type="submit" class="btn-gold">Réserver mon bilan →</button>
      </form>

      <p class="mt-6 text-sm text-navy/60">
        Tu préfères d'abord un aperçu rapide ?
        <button type="button" data-open-quiz class="font-semibold text-gold-dark underline">
          Fais le quiz programme
        </button>
        en 1 minute.
      </p>
    </div>
  </section>
</BaseLayout>
