---
import BaseLayout from '../layouts/BaseLayout.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
---

<BaseLayout
  title="Réserver un bilan athlétique gratuit — Alassane Coaching"
  description="Tu sais pas quel programme est fait pour toi ? On en parle. J'évalue ton profil, on définit ton objectif, j'identifie le bon plan. Gratuit, sans engagement."
>
  <!-- ===================== HERO ===================== -->
  <section class="bg-navy section-padding text-white">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow">Gratuit · sans engagement · 100% personnalisé</p>
      <h1 class="display-section">
        Tu sais pas par où commencer. C'est exactement pour ça que ce bilan existe.
      </h1>
      <p class="mt-6 text-lg text-cream/85">
        J'évalue ton profil — détente actuelle, force, objectifs. Et je t'oriente vers le
        programme qui correspond à où tu en es vraiment. Pas celui qui sonne bien. Le bon.
      </p>
    </div>
  </section>

  <!-- ===================== CE QUI SE PASSE PENDANT LE BILAN ===================== -->
  <section class="section-padding bg-cream">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Le bilan</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">Voilà ce qu'on fait ensemble.</h2>
      </div>
      <div class="mt-14 grid gap-6 md:grid-cols-3">
        {
          [
            {
              n: '1',
              title: 'On évalue ton niveau',
              body: 'Détente actuelle, force explosive, mobilité, historique des blessures. On fait le point sur où tu en es vraiment — pas où tu penses en être.',
            },
            {
              n: '2',
              title: 'On clarifie ton objectif',
              body: 'Dunker, gagner de la détente durable, performer en match : on définit une cible claire et mesurable. Pas vague. Concrète.',
            },
            {
              n: '3',
              title: 'On identifie ton programme',
              body: "Avec ces infos, je t'oriente vers le programme Athletik Hub le plus adapté à ton profil. Tu repars avec un plan. Pas des questions en plus.",
            },
          ].map((b) => (
            <div class="card">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-navy font-[var(--font-heading)] text-xl italic text-gold">
                {b.n}
              </span>
              <h3 class="mt-5 text-xl font-bold text-navy">{b.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-navy/70">{b.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== PREUVE SOCIALE ===================== -->
  <section class="bg-navy py-16 text-white">
    <div class="container-site max-w-3xl text-center">
      <p class="text-lg leading-relaxed text-cream/85">
        J'ai fait ce bilan avec <strong class="text-gold">900+ athlètes</strong>. Basketteurs,
        volleyeurs, joueurs de football américain, coachs sportifs, préparateurs physiques.
        Le profil change. La méthode, elle, reste la même.
      </p>
      <p class="mt-4 text-cream/70">
        +32 cm de détente sur moi-même d'abord. Ensuite, je l'ai appliqué sur les autres.
      </p>
    </div>
  </section>

  <!-- ===================== FORMULAIRE ===================== -->
  <section class="section-padding bg-white">
    <div class="container-site max-w-2xl">
      <div id="bilan-success" hidden class="mb-8 rounded-xl border border-gold/50 bg-cream p-6">
        <p class="font-semibold text-navy">Demande envoyée.</p>
        <p class="mt-1 text-sm text-navy/70">
          Je reviens vers toi sous 24-48h pour caler ton bilan athlétique.
        </p>
      </div>
      <script is:inline>
        if (new URLSearchParams(window.location.search).get('success') === 'true') {
          const el = document.getElementById('bilan-success');
          if (el) {
            el.hidden = false;
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
          }
        }
      </script>

      <h2 class="text-2xl font-bold text-navy sm:text-3xl">Tes informations.</h2>
      <p class="mt-2 text-navy/70">
        Réponds en 1 minute — je te recontacte pour fixer le créneau.
      </p>

      <form
        name="bilan"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/bilan?success=true"
        class="mt-10 space-y-6"
      >
        <input type="hidden" name="form-name" value="bilan" />
        <p class="hidden">
          <label>Ne pas remplir si tu es humain : <input name="bot-field" /></label>
        </p>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="prenom" class="mb-2 block text-sm font-medium text-navy">Prénom</label>
            <input
              id="prenom"
              name="prenom"
              type="text"
              required
              class="w-full rounded-xl border border-navy/12 bg-cream/30 px-4 py-3 text-navy transition-all duration-200 focus:border-gold focus:ring-2 focus:ring-gold/20 focus:outline-none"
            />
          </div>
          <div>
            <label for="email" class="mb-2 block text-sm font-medium text-navy">Email</label>
            <input
              id="email"
              name="email"
              type="email"
              required
              class="w-full rounded-xl border border-navy/12 bg-cream/30 px-4 py-3 text-navy transition-all duration-200 focus:border-gold focus:ring-2 focus:ring-gold/20 focus:outline-none"
            />
          </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            <label for="niveau" class="mb-2 block text-sm font-medium text-navy">Ton niveau actuel</label>
            <select
              id="niveau"
              name="niveau"
              required
              class="w-full rounded-xl border border-navy/12 bg-cream/30 px-4 py-3 text-navy transition-all duration-200 focus:border-gold focus:ring-2 focus:ring-gold/20 focus:outline-none"
            >
              <option value="Débutant">Je débute</option>
              <option value="Intermédiaire">J'ai de l'expérience</option>
              <option value="Confirmé">Je suis confirmé</option>
            </select>
          </div>
          <div>
            <label for="objectif" class="mb-2 block text-sm font-medium text-navy">Ton objectif principal</label>
            <select
              id="objectif"
              name="objectif"
              required
              class="w-full rounded-xl border border-navy/12 bg-cream/30 px-4 py-3 text-navy transition-all duration-200 focus:border-gold focus:ring-2 focus:ring-gold/20 focus:outline-none"
            >
              <option value="Dunker">Dunker</option>
              <option value="Détente durable">Gagner de la détente durable</option>
              <option value="Puissance / explosivité">Puissance & explosivité max</option>
              <option value="Bien démarrer">Bien démarrer sans me blesser</option>
            </select>
          </div>
        </div>

        <div>
          <label for="dispos" class="mb-2 block text-sm font-medium text-navy">Tes disponibilités</label>
          <input
            id="dispos"
            name="dispos"
            type="text"
            placeholder="Ex. en semaine après 18h, le week-end…"
            class="w-full rounded-xl border border-navy/12 bg-cream/30 px-4 py-3 text-navy placeholder:text-navy/40 transition-all duration-200 focus:border-gold focus:ring-2 focus:ring-gold/20 focus:outline-none"
          />
        </div>

        <div>
          <label for="message" class="mb-2 block text-sm font-medium text-navy">
            Un mot sur ta situation <span class="text-navy/40">(optionnel — mais ça m'aide à mieux préparer notre échange)</span>
          </label>
          <textarea
            id="message"
            name="message"
            rows="4"
            class="w-full rounded-xl border border-navy/12 bg-cream/30 px-4 py-3 text-navy transition-all duration-200 focus:border-gold focus:ring-2 focus:ring-gold/20 focus:outline-none"
          ></textarea>
        </div>

        <button type="submit" class="btn-gold">Réserver mon bilan →</button>
      </form>
    </div>
  </section>

  <!-- ===================== EN VIDÉO ===================== -->
  <section class="bg-navy-dark section-padding text-white">
    <div class="container-site max-w-4xl text-center">
      <p class="eyebrow">En vidéo</p>
      <h2 class="display-section">Fais connaissance avant qu'on échange.</h2>
      <p class="mx-auto mt-4 max-w-xl text-cream/80">
        Une vidéo vaut mieux qu'un long discours. Regarde comment je travaille — ça te
        donnera déjà une idée de l'état d'esprit.
      </p>
      <div class="mt-10">
        <VideoEmbed
          title="Présentation — Alassane Coaching"
          youtubeId="i2_HPT3Catc"
        />
      </div>
    </div>
  </section>

  <!-- ===================== RASSURANCE ===================== -->
  <section class="bg-cream py-16">
    <div class="container-site max-w-2xl text-center">
      <p class="text-lg leading-relaxed text-navy/80">
        Ce bilan, c'est gratuit. Sans engagement. Tu repars avec des réponses, pas avec un devis.
      </p>
      <p class="mt-4 text-navy/70">
        Si on est alignés, on continue ensemble. Sinon, t'as quand même progressé.
      </p>
    </div>
  </section>
</BaseLayout>
