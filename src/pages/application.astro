---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, PROGRAMS } from '../config/site';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Athletik Hub',
  applicationCategory: 'SportsApplication',
  inLanguage: 'fr',
  url: `${SITE.url}/application`,
  description:
    "Application de coaching qui accompagne les lecteurs du livre Les Secrets de la Détente Verticale avec des programmes, des tests et un suivi pour développer la détente verticale et l'explosivité.",
};

const features = [
  { title: 'Suivi des séances', body: 'Tu trackes ton entraînement et tu sais toujours où tu en es.' },
  { title: 'Progression en temps réel', body: 'Tu vois ton évolution semaine après semaine, pas juste tes sensations.' },
  { title: 'Vidéos de chaque exercice', body: 'Tu exécutes proprement, avec la technique sous les yeux.' },
  { title: 'Tests physiques & mesures', body: 'Tu mesures ce qui compte vraiment et tu ajustes.' },
  { title: '6 programmes prêts à l\'emploi', body: 'Le bon plan selon ton profil, identifié via le Bilan Athletic.' },
  { title: 'Pensée pour les lecteurs', body: 'L\'app prolonge le livre : la théorie devient un accompagnement concret.' },
];
---

<BaseLayout
  title="Athletik Hub : application de coaching pour explosivité et détente verticale"
  description="Athletik Hub accompagne les lecteurs du livre avec des programmes, tests et conseils pour développer leur détente verticale et leur explosivité."
  appendBrand={false}
  schema={schema}
>
  <!-- ===================== HERO ===================== -->
  <section class="bg-navy py-16 text-white">
    <div class="container-site max-w-3xl">
      <p class="eyebrow">L'application incluse avec le livre</p>
      <h1 class="display-section">
        Athletik Hub : l'application qui transforme le livre en coaching personnalisé.
      </h1>
      <p class="mt-6 text-lg leading-relaxed text-cream/85">
        La plupart des livres de sport t'arrêtent à la page. Athletik Hub va plus loin :
        tu suis des programmes, tu fais tes tests, tu trackes ta progression et tu relies
        chaque séance à ta détente verticale.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/livre" class="btn-gold">Découvrir le livre pour accéder à l'expérience complète →</a>
        <a href="#fonctionnement" class="btn-outline">Voir comment ça marche →</a>
      </div>
    </div>
  </section>

  <!-- ===================== CE QUE FAIT L'APP ===================== -->
  <section class="bg-white py-20">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Ce que fait Athletik Hub</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">Tout ton entraînement, dans ta poche.</h2>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <div class="rounded-2xl border border-navy/10 bg-cream/40 p-6">
              <h3 class="text-lg font-bold text-navy">{f.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy/70">{f.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== LES 6 PROGRAMMES ===================== -->
  <section class="bg-navy py-20 text-white">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Dans l'application</p>
        <h2 class="text-3xl font-bold sm:text-4xl">Les 6 programmes</h2>
        <p class="mt-4 text-cream/80">
          Tu fais le Bilan Athletic, le bon programme s'identifie, tu suis.
        </p>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          PROGRAMS.map((prog) => (
            <div class="rounded-2xl border border-white/10 bg-navy-light/40 p-6">
              <h3 class="font-[var(--font-heading)] text-lg font-bold text-gold">{prog.name}</h3>
              <p class="mt-2 text-sm text-cream/80">{prog.tagline}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-10 text-center">
        <button type="button" data-open-quiz class="btn-gold">Trouver mon programme →</button>
      </div>
    </div>
  </section>

  <!-- ===================== COMMENT ÇA MARCHE ===================== -->
  <section id="fonctionnement" class="bg-cream py-20">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">Comment ça marche</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">Du livre au coaching, en 4 étapes</h2>
      </div>
      <div class="mt-12 grid gap-6 md:grid-cols-4">
        {
          [
            { n: '1', t: 'Tu prends le livre', b: 'Athletik Hub est inclus avec Les Secrets de la Détente Verticale.' },
            { n: '2', t: 'Tu fais le Bilan Athletic', b: 'Tu évalues ton niveau et tes objectifs.' },
            { n: '3', t: 'Ton programme s\'identifie', b: 'Le bon plan parmi les 6 est sélectionné.' },
            { n: '4', t: 'Tu suis et tu mesures', b: 'Séances, vidéos, tests : tu progresses avec un cadre.' },
          ].map((s) => (
            <div class="rounded-2xl border border-navy/10 bg-white p-6">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-navy font-[var(--font-heading)] text-lg italic text-gold">
                {s.n}
              </span>
              <h3 class="mt-5 text-lg font-bold text-navy">{s.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-navy/70">{s.b}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ===================== CTA FINAL ===================== -->
  <section class="bg-white py-20">
    <div class="container-site max-w-3xl text-center">
      <h2 class="text-3xl font-bold text-navy sm:text-4xl">
        Le livre est la porte d'entrée d'Athletik Hub.
      </h2>
      <p class="mt-4 text-navy/70">
        L'application accompagne les lecteurs : pour accéder à l'expérience complète,
        commence par le livre.
      </p>
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/livre" class="btn-gold">Découvrir le livre →</a>
        <a href="/bilan" class="btn-outline !border-navy !text-navy hover:!bg-navy hover:!text-cream">
          Réserver un bilan →
        </a>
      </div>
      <p class="mt-6 text-sm text-navy/60">
        Envie d'en savoir plus sur ma méthode ?
        <a href="/a-propos" class="font-semibold text-gold-dark underline">Mon parcours</a>
        ·
        <a href="/blog" class="font-semibold text-gold-dark underline">le blog détente verticale</a>.
      </p>
    </div>
  </section>
</BaseLayout>
