---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SOCIALS } from '../config/site';

const faq = [
  {
    q: 'Comment accéder à Athletik Hub après l\'achat ?',
    a: 'Tu reçois un email avec tes accès dans les minutes suivant ta commande.',
  },
  {
    q: 'Le livre papier est-il disponible partout ?',
    a: 'Oui, via Amazon KDP, livraison internationale.',
  },
  {
    q: 'J\'ai un problème avec ma commande.',
    a: 'Utilise le formulaire, on règle ça rapidement.',
  },
];

---

<BaseLayout
  title="Contact"
  description="Une question sur ta commande, l'accès Athletik Hub ou un programme ? Écris à Alassane, réponse sous 24-48h."
  showQuiz={false}
>
  <section class="chevrons-navy py-16 text-white">
    <div class="container-site max-w-3xl text-center">
      <p class="eyebrow">Contact</p>
      <h1 class="text-3xl font-bold sm:text-4xl">Une question ? Je réponds personnellement.</h1>
      <p class="mt-5 text-cream/85">
        Commande, accès Athletik Hub, question sur un programme — écris-moi.
        Je réponds sous 24-48h.
      </p>
    </div>
  </section>

  <section class="bg-white py-16">
    <div class="container-site grid gap-12 lg:grid-cols-5">
      <!-- Formulaire -->
      <div class="lg:col-span-3">
        <!--
          Message de confirmation. Le site étant statique, on ne peut pas lire
          ?success=true au build : on rend le banner masqué et un script l'affiche
          après la redirection Netlify (action="/contact?success=true").
        -->
        <div id="contact-success" hidden class="mb-6 rounded-xl border border-gold/50 bg-cream p-5">
          <p class="font-semibold text-navy">Merci, ton message est bien parti ✅</p>
          <p class="mt-1 text-sm text-navy/70">
            Je te réponds personnellement sous 24-48h.
          </p>
        </div>
        <script is:inline>
          if (new URLSearchParams(window.location.search).get('success') === 'true') {
            const el = document.getElementById('contact-success');
            if (el) {
              el.hidden = false;
              el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }
        </script>

        <!--
          Formulaire Netlify Forms.
          - data-netlify="true" : détection automatique au build.
          - honeypot "bot-field" : anti-spam (recommandation Netlify).
          - action vers /contact?success=true pour le message de confirmation.
        -->
        <form
          name="contact"
          method="POST"
          data-netlify="true"
          netlify-honeypot="bot-field"
          action="/contact?success=true"
          class="space-y-5"
        >
          <input type="hidden" name="form-name" value="contact" />
          <p class="hidden">
            <label>Ne pas remplir si tu es humain : <input name="bot-field" /></label>
          </p>

          <div class="grid gap-5 sm:grid-cols-2">
            <div>
              <label for="prenom" class="mb-1.5 block text-sm font-medium text-navy">Prénom</label>
              <input
                id="prenom"
                name="prenom"
                type="text"
                required
                class="w-full rounded-lg border border-navy/15 px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
              />
            </div>
            <div>
              <label for="email" class="mb-1.5 block text-sm font-medium text-navy">Email</label>
              <input
                id="email"
                name="email"
                type="email"
                required
                class="w-full rounded-lg border border-navy/15 px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
              />
            </div>
          </div>

          <div>
            <label for="sujet" class="mb-1.5 block text-sm font-medium text-navy">Sujet</label>
            <select
              id="sujet"
              name="sujet"
              required
              class="w-full rounded-lg border border-navy/15 bg-white px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
            >
              <option value="Commande">Commande</option>
              <option value="Athletik Hub">Athletik Hub</option>
              <option value="Programme">Programme</option>
              <option value="Autre">Autre</option>
            </select>
          </div>

          <div>
            <label for="message" class="mb-1.5 block text-sm font-medium text-navy">Message</label>
            <textarea
              id="message"
              name="message"
              rows="5"
              required
              class="w-full rounded-lg border border-navy/15 px-4 py-2.5 text-navy focus:border-gold focus:outline-none"
            ></textarea>
          </div>

          <button type="submit" class="btn-gold">Envoyer →</button>
        </form>
      </div>

      <!-- FAQ + réseaux -->
      <aside class="lg:col-span-2">
        <h2 class="font-[var(--font-heading)] text-xl font-bold text-navy">FAQ rapide</h2>
        <div class="mt-5 space-y-5">
          {
            faq.map((item) => (
              <div class="rounded-xl border border-navy/10 bg-cream/40 p-5">
                <p class="font-semibold text-navy">{item.q}</p>
                <p class="mt-2 text-sm text-navy/70">{item.a}</p>
              </div>
            ))
          }
        </div>

        <h2 class="mt-8 font-[var(--font-heading)] text-xl font-bold text-navy">Réseaux</h2>
        <div class="mt-4 flex flex-wrap gap-3">
          <a href={SOCIALS.instagram} target="_blank" rel="noopener noreferrer" class="rounded-full border border-navy/15 px-4 py-2 text-sm font-medium text-navy transition-colors hover:border-gold hover:text-gold">
            Instagram @alassanecoaching
          </a>
          <a href={SOCIALS.youtube} target="_blank" rel="noopener noreferrer" class="rounded-full border border-navy/15 px-4 py-2 text-sm font-medium text-navy transition-colors hover:border-gold hover:text-gold">
            YouTube
          </a>
          <a href={SOCIALS.tiktok} target="_blank" rel="noopener noreferrer" class="rounded-full border border-navy/15 px-4 py-2 text-sm font-medium text-navy transition-colors hover:border-gold hover:text-gold">
            TikTok
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
