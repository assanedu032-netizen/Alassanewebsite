---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SOCIALS, ATHLETIK_HUB_URL } from '../config/site';
import portrait from '../assets/alassane-portrait.jpg';
import squatDay from '../assets/squat-day.jpg';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Alassane Ndiaye',
  jobTitle: 'Coach spécialisé en détente verticale et explosivité',
  description:
    "Recalé à 14 ans. +32 cm de détente gagnés. 10 000 € investis en formations. Certification ISSA. 900+ athlètes coachés. Voilà d'où vient la méthode.",
  url: `${SITE.url}/a-propos`,
  sameAs: [SOCIALS.instagram],
  brand: {
    '@type': 'Organization',
    name: 'Alassane Coaching',
    url: SITE.url,
  },
  worksFor: {
    '@type': 'Organization',
    name: 'Alassane Coaching',
    url: SITE.url,
  },
  knowsAbout: [
    'Détente verticale',
    'Explosivité',
    'Basketball',
    'Préparation physique',
    'Performance athlétique',
    'Pliométrie',
  ],
  hasCredential: 'Certification ISSA',
};

const stats = [
  { value: '56 → 88 cm', label: 'de détente' },
  { value: '10 000 €', label: 'investis en formations' },
  { value: 'USA', label: 'formé avec des coachs NBA/NFL' },
  { value: 'ISSA', label: 'certification' },
  { value: '900+', label: 'athlètes testés' },
  { value: '378 pages', label: '· 6 programmes' },
];
---

<BaseLayout
  title="Alassane Ndiaye — Coach détente verticale, auteur, ancien basketteur"
  description="Recalé à 14 ans. +32 cm de détente gagnés. 10 000 € investis en formations. Certification ISSA. 900+ athlètes coachés. Voilà d'où vient la méthode."
  appendBrand={false}
  schema={schema}
>
  <!-- ===================== HERO ===================== -->
  <section class="bg-navy section-padding text-white">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Alassane Ndiaye · Coach détente verticale &amp; explosivité</p>
        <h1 class="display-section">
          À 14 ans, je faisais moins d'1m60. Et j'avais été recalé à une détection.
        </h1>
        <p class="mt-7 leading-relaxed text-cream/90">
          On m'a dit que je n'avais pas le profil.
          Je suis rentré chez moi en pleurant de rage.
          Alors j'ai décidé de construire le mien.
        </p>
        <blockquote class="mt-6 border-l-4 border-gold pl-5 italic text-cream/80">
          « Les gens vraiment forts n'ont pas besoin de détection. Si t'es pas fort là où tu es,
          tu le seras pas en jouant avec des meilleurs que toi. »
        </blockquote>
        <p class="mt-3 text-sm text-cream/50">— Mon frère</p>
      </div>
      <div>
        <Image
          src={portrait}
          alt="Portrait d'Alassane, coach en performance athlétique"
          class="mx-auto aspect-[3/4] w-full max-w-sm rounded-2xl object-cover shadow-2xl shadow-navy/40 ring-1 ring-gold/20"
          widths={[400, 600, 900]}
          sizes="(max-width: 1024px) 100vw, 40vw"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- ===================== LE PARCOURS ===================== -->
  <section class="section-padding bg-white">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Le parcours</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">
          4 ans. Des blessures. 10 000 €. Et 32 cm de plus.
        </h2>
        <p class="mt-6 leading-relaxed text-navy/75">
          J'ai passé les années suivantes à chercher ce qui fonctionnait réellement.
        </p>
        <p class="mt-4 leading-relaxed text-navy/75">
          4 ans d'entraînement. Des blessures. Des erreurs.
          Plus de 10 000 € investis en formations.
          Je suis même allé aux États-Unis pour me former auprès de coachs travaillant avec des athlètes NBA et NFL.
        </p>
        <p class="mt-4 leading-relaxed text-navy/75">
          Puis j'ai commencé à mettre ces connaissances en pratique.
        </p>
        <div class="mt-6">
          <p class="font-[var(--font-heading)] text-3xl font-bold text-navy">56 cm → 88 cm</p>
          <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-gold">+32 cm de détente verticale</p>
        </div>
      </div>
      <div>
        <Image
          src={squatDay}
          alt="Alassane à l'entraînement — squat explosif en extérieur"
          class="aspect-[4/5] w-full rounded-2xl object-cover shadow-xl shadow-navy/20 ring-1 ring-navy/10"
          widths={[400, 700, 1000]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ===================== POURQUOI CE LIVRE ===================== -->
  <section class="section-padding bg-cream">
    <div class="container-site max-w-3xl">
      <p class="eyebrow">Pourquoi ce livre</p>
      <h2 class="text-3xl font-bold text-navy sm:text-4xl">Pourquoi ce livre existe.</h2>
      <p class="mt-6 text-lg leading-relaxed text-navy/80">
        Et après avoir accompagné 900+ athlètes, une conviction s'est imposée :
        la plupart des sportifs ne manquent pas de motivation.
        Ils manquent surtout d'un système.
      </p>
      <p class="mt-5 text-lg leading-relaxed text-navy/80">
        C'est pour ça que j'ai écrit <em>Les Secrets de la Détente Verticale</em>.
      </p>
      <p class="mt-5 leading-relaxed text-navy/75">
        Ce livre, c'est celui que j'aurais voulu avoir à 14 ans.<br />
        Pour comprendre plus tôt.<br />
        Pour éviter les erreurs.<br />
        Pour arrêter de perdre du temps.<br />
        Et pour ne pas avoir à dépenser 10 000 € pour trouver les réponses.
      </p>
    </div>
  </section>

  <!-- ===================== EN CHIFFRES ===================== -->
  <section class="section-padding bg-navy text-white">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">En chiffres</p>
        <h2 class="text-3xl font-bold sm:text-4xl">Le parcours en données.</h2>
      </div>
      <div class="mt-14 grid grid-cols-2 gap-6 sm:grid-cols-3">
        {
          stats.map((stat) => (
            <div class="card-dark text-center">
              <p class="font-[var(--font-heading)] text-4xl leading-none text-gold sm:text-5xl lg:text-6xl">
                {stat.value}
              </p>
              <p class="mt-3 text-sm text-cream/70">{stat.label}</p>
            </div>
          ))
        }
      </div>
      <div class="mt-14 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="/livre" class="btn-gold">Découvrir le livre →</a>
        <a href={ATHLETIK_HUB_URL} target="_blank" rel="noopener noreferrer" class="btn-outline">Accéder à Athletik Hub →</a>
      </div>
      <p class="mt-6 text-center text-sm text-cream/70">
        Envie de conseils concrets ?
        <a href="/blog" class="font-semibold text-gold underline">Lis le blog détente verticale</a>.
      </p>
    </div>
  </section>
</BaseLayout>
