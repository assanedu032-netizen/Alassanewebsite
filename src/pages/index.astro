---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, BOOK, SOCIALS, ATHLETIK_HUB_URL } from '../config/site';
import courtNight from '../assets/court-night.jpg';
import squatDay from '../assets/squat-day.jpg';
import appLivreApp from '../assets/app-livre-app.jpg';
import livreMockup from '../assets/livre-mockup.png';
import VideoEmbed from '../components/VideoEmbed.astro';

const sameAs = [SOCIALS.instagram, SOCIALS.youtube, SOCIALS.tiktok].filter(
  (u) => u && u !== '#',
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'Alassane Coaching',
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'fr',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/og-default.png`,
    sameAs,
  },
];

const methodSteps = [
  { n: '01', label: 'Évaluer', body: 'Comprendre ton niveau actuel et tes paramètres de départ.' },
  { n: '02', label: 'Identifier', body: 'Déterminer les qualités physiques à travailler en priorité selon ton profil.' },
  { n: '03', label: 'Programmer', body: 'Construire une progression structurée, cohérente et adaptée à tes objectifs.' },
  { n: '04', label: 'Exécuter', body: "S'entraîner avec les bons exercices, la bonne technique et la bonne intensité." },
  { n: '05', label: 'Mesurer', body: 'Suivre les performances pour savoir précisément ce qui progresse.' },
  { n: '06', label: 'Ajuster', body: 'Faire évoluer le travail selon les résultats — et ne jamais stagner.' },
];

const problems = [
  "Tu passes d'un programme à l'autre dès que ça stagne.",
  "Tu regardes des vidéos YouTube, tu essaies de nouveaux exercices chaque semaine.",
  "Tu empiles squats, box jumps, sauts, élastiques — sans savoir pourquoi dans cet ordre.",
  "Tu ne sais pas exactement ce que tu cherches à développer.",
  "Tu ne mesures pas ta progression — ou tu ne sais pas quoi mesurer.",
  "Tu travailles fort. Mais sans logique de progression, les résultats ne suivent pas.",
];

const hubFeatures = [
  'Tests physiques & mesure de ta détente verticale',
  'Programmes adaptés à ton profil athlétique',
  'Suivi de séances et de progression',
  'Vidéos de démonstration pour chaque exercice',
];
---

<BaseLayout
  title="Alassane Coaching — Saute plus haut. Méthode, livre & application."
  description="+32 cm de détente gagnés. 900+ athlètes accompagnés. La méthode complète pour basketteurs, volleyeurs et athlètes explosifs — livre + app Athletik Hub."
  appendBrand={false}
  schema={schema}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative flex min-h-[85vh] items-center overflow-hidden bg-gradient-to-b from-navy-light via-navy to-navy-dark text-white">
    <div
      class="pointer-events-none absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full bg-gold/8 blur-[100px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-gold/5 blur-[80px]"
      aria-hidden="true"
    ></div>

    <div class="container-site relative py-24 sm:py-32">
      <div class="mx-auto max-w-4xl text-center">
        <p class="eyebrow">Pour basketteurs · volleyeurs · athlètes explosifs</p>
        <h1 class="display-hero">
          Tu veux sauter plus haut.<br />
          <span class="text-gold">Arrête de t'entraîner au hasard.</span>
        </h1>

        <div class="mt-10 inline-flex flex-wrap items-center justify-center gap-3 rounded-2xl border border-gold/25 bg-white/6 px-7 py-5 backdrop-blur-sm sm:gap-5">
          <div class="text-center">
            <p class="font-[var(--font-heading)] text-2xl font-bold text-white/50 sm:text-3xl">56 cm</p>
            <p class="mt-0.5 text-xs uppercase tracking-widest text-white/35">départ</p>
          </div>
          <div class="text-2xl font-light text-gold/60 sm:text-3xl">→</div>
          <div class="text-center">
            <p class="font-[var(--font-heading)] text-2xl font-bold text-gold sm:text-3xl">88 cm</p>
            <p class="mt-0.5 text-xs uppercase tracking-widest text-gold/60">+32 cm</p>
          </div>
          <div class="hidden h-8 w-px bg-white/10 sm:block"></div>
          <p class="text-sm text-cream/60">4 ans de travail structuré.<br class="sm:hidden" /> Pas de génétique exceptionnelle.</p>
        </div>

        <p class="mx-auto mt-8 max-w-2xl text-base leading-relaxed text-cream/80 sm:text-lg">
          J'ai construit un <strong class="text-white">système</strong> — pas accumulé des programmes.
          Évaluations, logique de progression, mesures qui ont du sens. Voilà ce qu'on fait ici.
        </p>

        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:justify-center">
          <a href={BOOK.amazon} target="_blank" rel="noopener noreferrer" class="btn-gold text-base">
            Découvrir le livre · Kindle {BOOK.priceKindle} →
          </a>
          <a href="/bilan" class="btn-outline text-base">
            Faire mon bilan gratuit →
          </a>
        </div>
      </div>
    </div>

    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
      <svg class="h-6 w-6 text-gold/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- ===================== BANDE PREUVE — PHOTO + STATS ===================== -->
  <section class="relative bg-navy">
    <div class="relative h-[55vh] min-h-[360px] w-full overflow-hidden">
      <Image
        src={courtNight}
        alt="Alassane sur un terrain de basket en soirée, en plein coaching"
        class="absolute inset-0 h-full w-full object-cover object-center"
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/20 to-navy/40"></div>

      <div class="absolute inset-x-0 bottom-0">
        <div class="container-site flex flex-wrap items-end justify-center gap-x-10 gap-y-5 pb-10 text-center text-white drop-shadow-lg sm:gap-x-14 lg:gap-x-20">
          <div>
            <p class="font-[var(--font-heading)] text-4xl italic text-gold sm:text-5xl">+32 cm</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/75">progression perso · de 56 à 88 cm</p>
          </div>
          <div>
            <p class="font-[var(--font-heading)] text-4xl italic text-gold sm:text-5xl">900+</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/75">athlètes évalués et accompagnés</p>
          </div>
          <div>
            <p class="font-[var(--font-heading)] text-4xl italic text-gold sm:text-5xl">10 ans</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/75">de terrain et de recherche</p>
          </div>
          <div>
            <p class="font-[var(--font-heading)] text-4xl italic text-gold sm:text-5xl">378</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/75">pages · méthode complète</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== LE PROBLÈME ===================== -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="mx-auto max-w-3xl">
        <p class="eyebrow">Le constat</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">
          Tu travailles dur.<br class="hidden sm:block" />
          Ta détente ne bouge plus.
        </h2>
        <p class="mt-5 text-lg text-navy/65">
          Voilà les signaux que je vois chez la plupart des athlètes qui stagnent.
        </p>
        <ul class="mt-8 divide-y divide-navy/8">
          {
            problems.map((p) => (
              <li class="flex items-start gap-4 py-4">
                <span class="mt-1 flex-none text-sm font-bold text-gold">—</span>
                <span class="leading-relaxed text-navy/75">{p}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ===================== TRANSITION — LE VRAI PROBLÈME ===================== -->
  <section class="section-padding bg-cream">
    <div class="container-site">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">La vraie raison</p>
        <h2 class="text-3xl font-bold text-navy sm:text-5xl sm:leading-tight">
          Le problème n'est pas ton manque d'effort.
        </h2>
        <p class="mt-4 text-2xl font-semibold text-gold sm:text-3xl">
          C'est l'absence de système.
        </p>
        <p class="mx-auto mt-8 max-w-2xl leading-relaxed text-navy/70">
          Un système, ça veut dire : savoir où tu en es, comprendre ce que tu cherches à développer,
          construire une progression cohérente, et mesurer ce qui change vraiment.
          Sans ça, même les meilleurs exercices donnent des résultats aléatoires.
        </p>
      </div>
    </div>
  </section>

  <!-- ===================== LA MÉTHODE ===================== -->
  <section class="section-padding bg-navy text-white">
    <div class="container-site">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">La méthode</p>
        <h2 class="text-3xl font-bold sm:text-4xl">
          Pas un programme. Un système.
        </h2>
        <p class="mt-4 text-cream/65">
          C'est la logique qui structure le livre, les 6 programmes et Athletik Hub.
        </p>
      </div>

      <div class="mt-14 overflow-hidden rounded-2xl border border-white/8 sm:grid sm:grid-cols-2 lg:grid-cols-3">
        {
          methodSteps.map((step, i) => (
            <div class={`p-8 sm:p-9 border-b border-white/6 last:border-0 ${i % 2 === 0 ? 'bg-navy-dark' : 'bg-navy'}`}>
              <p class="font-[var(--font-heading)] text-5xl font-bold text-gold/25">{step.n}</p>
              <p class="mt-3 text-lg font-bold text-white">{step.label}</p>
              <p class="mt-2 text-sm leading-relaxed text-cream/55">{step.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-12 text-center">
        <a href="/livre" class="btn-gold">Voir la méthode complète →</a>
      </div>
    </div>
  </section>

  <!-- ===================== STORYTELLING ===================== -->
  <section class="section-padding bg-cream">
    <div class="container-site grid items-start gap-14 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <p class="eyebrow">Mon parcours</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">
          À 14 ans, on m'a fait comprendre<br class="hidden sm:block" />
          que je n'avais pas le profil.
        </h2>

        <div class="mt-8 space-y-5">
          <p class="leading-relaxed text-navy/80">
            14 ans. Moins d'1m60. Détection à Nanterre. Refus.
            Je suis rentré chez moi avec une certitude : je ne leur donnais pas raison.
          </p>
          <p class="leading-relaxed text-navy/80">
            J'ai passé les années suivantes à chercher ce qui fonctionnait réellement.
            4 ans d'entraînement. Des blessures. Des erreurs. Plus de 10 000 € investis.
            Des formations spécialisées. Un déplacement aux États-Unis pour apprendre
            auprès de coachs travaillant avec des athlètes NBA et NFL. Certification ISSA.
          </p>
          <p class="leading-relaxed text-navy/80">
            Puis j'ai appliqué ce que j'avais appris — sur moi, puis sur d'autres.
            900+ athlètes évalués et accompagnés.
          </p>
        </div>

        <div class="mt-8 rounded-2xl border border-navy/10 bg-white p-7">
          <p class="font-[var(--font-heading)] text-4xl font-bold text-navy">56 cm → 88 cm</p>
          <p class="mt-1 text-sm font-semibold uppercase tracking-wide text-gold">
            +32 cm de détente verticale · 4 ans de travail structuré
          </p>
          <p class="mt-3 text-sm leading-relaxed text-navy/55">
            Pas de génétique exceptionnelle. Un système.
          </p>
        </div>

        <p class="mt-7 leading-relaxed text-navy/70">
          Les Secrets de la Détente Verticale, c'est le livre que j'aurais aimé avoir à 14 ans.
          Pour ne pas dépenser 10 000 € à chercher les réponses.
        </p>

        <a href="/a-propos" class="btn-outline mt-7 !border-navy !text-navy hover:!bg-navy hover:!text-cream">
          Mon histoire complète →
        </a>
      </div>

      <div class="order-1 lg:order-2">
        <Image
          src={squatDay}
          alt="Alassane à l'entraînement, squat explosif en extérieur"
          class="aspect-[4/5] w-full rounded-2xl object-cover shadow-xl shadow-navy/20 ring-1 ring-navy/10"
          widths={[400, 700, 1000]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ===================== LE LIVRE ===================== -->
  <section class="section-padding bg-white">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div class="flex justify-center">
        <figure class="w-full max-w-lg overflow-hidden rounded-2xl shadow-2xl shadow-navy/20">
          <Image
            src={livreMockup}
            alt="Le livre Les Secrets de la Détente Verticale — méthode complète"
            class="block w-full"
            widths={[400, 700, 1000]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
        </figure>
      </div>

      <div>
        <p class="eyebrow">Le livre</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">
          Tout ce que j'aurais aimé<br class="hidden sm:block" />
          comprendre à 14 ans.
        </h2>
        <p class="mt-6 leading-relaxed text-navy/75">
          {BOOK.pages} pages. La science du saut. La méthode MENER.
          6 programmes adaptés à chaque profil. Et la pédagogie d'un coach
          qui a lui-même dû construire sa progression.
        </p>
        <p class="mt-4 leading-relaxed text-navy/75">
          Le livre n'est pas une recette. C'est une compréhension — des mécanismes,
          des erreurs à éviter, et de la logique derrière chaque décision d'entraînement.
        </p>

        <div class="mt-8 flex flex-wrap gap-x-8 gap-y-3">
          <div>
            <p class="text-sm text-navy/45">Kindle</p>
            <p class="text-2xl font-bold text-gold">{BOOK.priceKindle}</p>
          </div>
          <div>
            <p class="text-sm text-navy/45">Papier</p>
            <p class="text-2xl font-bold text-gold">{BOOK.pricePaper}</p>
          </div>
        </div>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={BOOK.amazon} target="_blank" rel="noopener noreferrer" class="btn-gold">
            Acheter sur Amazon →
          </a>
          <a href="/livre" class="btn-outline !border-navy !text-navy hover:!bg-navy hover:!text-cream">
            En savoir plus →
          </a>
        </div>
        <p class="mt-4 text-xs text-navy/35">Athletik Hub inclus dans les deux versions.</p>
      </div>
    </div>
  </section>

  <!-- ===================== ATHLETIK HUB ===================== -->
  <section class="section-padding bg-navy text-white">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="eyebrow">L'application incluse</p>
        <h2 class="text-3xl font-bold sm:text-4xl">
          Tu comprends la méthode.<br class="hidden sm:block" />
          Maintenant, applique-la.
        </h2>
        <p class="mt-6 leading-relaxed text-cream/80">
          Athletik Hub est le prolongement pratique du livre.
          Pas une app de fitness générique — un outil construit autour de la méthode.
        </p>
        <ul class="mt-7 space-y-3">
          {
            hubFeatures.map((feat) => (
              <li class="flex items-center gap-3 text-sm text-cream/85">
                <svg class="h-5 w-5 flex-none text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                </svg>
                {feat}
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-sm italic text-cream/45">
          Le livre t'explique quoi faire et pourquoi.
          Athletik Hub t'aide à l'appliquer et à suivre ta progression.
        </p>
        <a href={ATHLETIK_HUB_URL} target="_blank" rel="noopener noreferrer" class="btn-outline mt-8">
          Accéder à Athletik Hub →
        </a>
      </div>

      <div class="flex justify-center">
        <figure class="relative w-full max-w-xl overflow-hidden rounded-2xl shadow-2xl shadow-black/30 ring-1 ring-gold/15">
          <Image
            src={appLivreApp}
            alt="Le livre Les Secrets de la Détente Verticale et l'application Athletik Hub"
            class="block w-full"
            widths={[400, 700, 1000]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-navy mix-blend-lighten"></div>
          <div class="pointer-events-none absolute inset-0 bg-navy/12"></div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===================== EN VIDÉO ===================== -->
  <section class="section-padding bg-navy-dark text-white">
    <div class="container-site max-w-4xl text-center">
      <h2 class="display-section">Regarde plutôt que de lire.</h2>
      <div class="mt-10">
        <VideoEmbed
          title="Présentation — Alassane Coaching"
          youtubeId="i2_HPT3Catc"
        />
      </div>
    </div>
  </section>

  <!-- ===================== NEWSLETTER ===================== -->
  <Newsletter
    title="Entraîne-toi mieux. Pas plus."
    subtitle="Méthode, explosivité, erreurs d'entraînement, détente verticale — ce que j'apprends sur le terrain, directement dans ta boîte. Sans bullshit."
  />
</BaseLayout>
