---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, BOOK, SOCIALS, ATHLETIK_HUB_URL } from '../config/site';
import courtNight from '../assets/court-night.jpg';
import squatDay from '../assets/squat-day.jpg';
import appLivreApp from '../assets/app-livre-app.jpg';
import VideoEmbed from '../components/VideoEmbed.astro';

const sameAs = [SOCIALS.instagram, SOCIALS.youtube, SOCIALS.tiktok].filter(
  (u) => u && u !== '#',
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    alternateName: 'Alassane Coaching',
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'fr',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/og-default.png`,
    sameAs,
  },
];
---

<BaseLayout
  title="Alassane Coaching — Saute plus haut. Méthode, livre & application."
  description="+32 cm de détente gagnés. 900+ athlètes coachés. La méthode complète pour basketteurs, volleyeurs et athlètes explosifs — livre + app Athletik Hub."
  appendBrand={false}
  schema={schema}
>
  <!-- ===================== HERO ===================== -->
  <section class="relative flex min-h-[80vh] items-center overflow-hidden bg-gradient-to-b from-navy-light via-navy to-navy-dark text-white">
    <div
      class="pointer-events-none absolute -right-32 -top-32 h-[500px] w-[500px] rounded-full bg-gold/8 blur-[100px]"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -left-24 bottom-0 h-80 w-80 rounded-full bg-gold/5 blur-[80px]"
      aria-hidden="true"
    ></div>

    <div class="container-site relative py-28">
      <div class="mx-auto max-w-4xl text-center">
        <p class="eyebrow">Pour basketteurs · volleyeurs · athlètes explosifs</p>
        <h1 class="display-hero">
          Tu veux sauter plus haut.<br />
          <span class="text-gold">Arrête de t'entraîner au hasard.</span>
        </h1>
        <p class="mx-auto mt-8 max-w-2xl text-lg leading-relaxed text-cream/85">
          J'ai gagné <strong class="text-white">32 cm</strong> de détente en construisant un
          vrai système — pas en accumulant des programmes trouvés sur YouTube. Voilà la méthode.
        </p>
        <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:justify-center">
          <a href={BOOK.amazon} target="_blank" rel="noopener noreferrer" class="btn-gold text-base">
            Découvrir le livre · Kindle {BOOK.priceKindle} / Papier {BOOK.pricePaper} →
          </a>
          <a href="/bilan" class="btn-outline text-base">
            Réserver mon bilan gratuit →
          </a>
        </div>
        <div class="mt-5 flex justify-center gap-5 text-xs text-cream/50">
          <span>✓ Athletik Hub inclus</span>
          <span>✓ Paiement sécurisé Amazon</span>
          <span>✓ Accès immédiat Kindle</span>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-6 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
      <svg class="h-6 w-6 text-gold/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19 9-7 7-7-7" />
      </svg>
    </div>
  </section>

  <!-- ===================== BANDE PHOTO + CHIFFRES ===================== -->
  <section class="relative bg-navy">
    <div class="relative h-[60vh] min-h-[440px] w-full overflow-hidden">
      <Image
        src={courtNight}
        alt="Alassane sur un terrain de basket en soirée, en plein coaching"
        class="absolute inset-0 h-full w-full object-cover object-center"
        widths={[640, 1024, 1440, 1920]}
        sizes="100vw"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-navy via-navy/10 to-navy/30"></div>

      <div class="absolute inset-x-0 bottom-0">
        <div class="container-site flex flex-wrap items-end justify-center gap-x-12 gap-y-6 pb-10 text-center text-white drop-shadow-lg sm:gap-x-20">
          <div>
            <p class="font-[var(--font-heading)] text-4xl italic text-gold sm:text-5xl">+32 cm</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/90">ma progression perso · de 56 à 88 cm</p>
          </div>
          <div>
            <p class="font-[var(--font-heading)] text-4xl italic text-gold sm:text-5xl">900+</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/90">athlètes coachés et testés</p>
          </div>
          <div>
            <p class="font-[var(--font-heading)] text-4xl italic text-gold sm:text-5xl">10 ans</p>
            <p class="mt-1 text-xs uppercase tracking-[0.18em] text-white/90">de terrain condensés dans un système</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== PROBLÈME ===================== -->
  <section class="section-padding bg-white">
    <div class="container-site">
      <div class="mx-auto max-w-3xl text-center">
        <p class="eyebrow">La vraie raison</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">
          Tu travailles dur. Ta détente, elle bouge pas.
        </h2>
        <p class="mt-5 text-navy/70">
          Tu regardes des vidéos. Tu essaies un programme. Deux semaines. Rien. Tu en
          cherches un autre. Même résultat. Et une pensée s'installe :
          <em class="text-navy/90">« C'est peut-être ma génétique. C'est peut-être pas pour moi. »</em>
        </p>
        <p class="mt-3 text-lg font-semibold text-navy">Non. Le problème, c'est autre chose.</p>
      </div>

      <div class="mt-14 grid gap-8 md:grid-cols-3">
        {
          [
            {
              n: '1',
              title: "Tu empiles des exercices sans comprendre ce que tu développes.",
              body: "Squats, sauts, élastiques, pliométrie — dans le désordre. Sans logique de périodisation, tu travailles fort pour des résultats aléatoires.",
            },
            {
              n: '2',
              title: "Ton corps s'adapte. Et tu t'en rends pas compte.",
              body: "Après 3 à 4 semaines, il a intégré le stimulus. Il s'y est habitué. Il n'a plus aucune raison de progresser. C'est de la biologie — pas de la flemme.",
            },
            {
              n: '3',
              title: 'Tu mesures pas ce qui compte vraiment.',
              body: "Pas juste ta hauteur de saut — ta force explosive, ta triple extension, ton indice de réactivité. Ce que tu mesures pas, tu peux pas l'améliorer.",
            },
          ].map((item) => (
            <div class="card bg-cream/40">
              <span class="flex h-12 w-12 items-center justify-center rounded-full bg-navy font-[var(--font-heading)] text-xl font-bold text-gold">
                {item.n}
              </span>
              <h3 class="mt-5 text-lg font-bold text-navy">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-navy/70">{item.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-14 text-center">
        <p class="text-navy/70">
          Ces 3 points, c'est la base de tout ce que tu trouveras dans le livre.
        </p>
        <a href="/livre" class="btn-gold mt-6">Voir le système complet →</a>
      </div>
    </div>
  </section>

  <!-- ===================== SOLUTION — LE SYSTÈME ===================== -->
  <section class="section-padding bg-navy text-white">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="eyebrow">Le système complet</p>
        <h2 class="text-3xl font-bold sm:text-4xl">
          Un livre. Une app. Un seul système.
        </h2>
        <p class="mt-6 leading-relaxed text-cream/80">
          Pas deux produits séparés — un écosystème pensé ensemble. Le livre te donne la
          compréhension. Athletik Hub te donne le cadre pour agir chaque jour.
        </p>
        <ul class="mt-8 space-y-4">
          {
            [
              `${BOOK.pages} pages de science vulgarisée, de méthodes et de programmes.`,
              `Athletik Hub — tracker ta progression séance par séance, accéder aux vidéos, faire tes tests.`,
              `${BOOK.programs} programmes identifiés selon ton profil via le Bilan Athletic gratuit.`,
            ].map((line) => (
              <li class="flex items-start gap-3">
                <svg class="mt-0.5 h-6 w-6 flex-none text-gold" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="m5 13 4 4L19 7" />
                </svg>
                <span class="text-cream/90">{line}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row">
          <a href="/livre" class="btn-gold">Découvrir le livre →</a>
          <a href={ATHLETIK_HUB_URL} target="_blank" rel="noopener noreferrer" class="btn-outline">Accéder à Athletik Hub →</a>
        </div>
      </div>

      <div class="flex justify-center">
        <figure class="relative w-full max-w-xl overflow-hidden rounded-2xl shadow-2xl shadow-black/30 ring-1 ring-gold/15">
          <Image
            src={appLivreApp}
            alt="Le livre Les Secrets de la Détente Verticale et l'application Athletik Hub"
            class="block w-full"
            widths={[400, 700, 1000]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            loading="lazy"
          />
          <div class="pointer-events-none absolute inset-0 bg-navy mix-blend-lighten"></div>
          <div class="pointer-events-none absolute inset-0 bg-navy/12"></div>
        </figure>
      </div>
    </div>
  </section>

  <!-- ===================== EN VIDÉO ===================== -->
  <section class="section-padding bg-navy-dark text-white">
    <div class="container-site max-w-4xl text-center">
      <h2 class="display-section">Regarde plutôt que de lire.</h2>
      <div class="mt-10">
        <VideoEmbed
          title="Présentation — Alassane Coaching"
          youtubeId="i2_HPT3Catc"
        />
      </div>
    </div>
  </section>

  <!-- ===================== HISTOIRE / CRÉDIBILITÉ ===================== -->
  <section class="section-padding bg-cream">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <p class="eyebrow">Mon parcours</p>
        <h2 class="text-3xl font-bold text-navy sm:text-4xl">
          14 ans. Moins d'1m60. Recalé à la détection de Nanterre.
        </h2>
        <p class="mt-6 leading-relaxed text-navy/75">
          On m'a dit que j'avais pas le profil. Je suis rentré chez moi en pleurant de rage.
          Alors j'ai décidé de construire le mien.
        </p>
        <p class="mt-4 leading-relaxed text-navy/75">
          4 ans d'entraînement. Des blessures. Plus de 10 000 € investis en formations.
          Un déplacement aux États-Unis pour me former en privé avec des coachs NBA et NFL.
          Certification ISSA. 900+ athlètes ensuite.
        </p>
        <p class="mt-4 leading-relaxed text-navy/75">
          Résultat : <strong class="text-navy">56 cm → 88 cm.</strong> +32 cm. En partant de rien.
        </p>
        <p class="mt-5 text-navy/70">
          Ce livre, c'est ce que j'aurais voulu avoir à 14 ans — pour éviter les erreurs,
          le temps perdu, et les 10 000 € brûlés.
        </p>
        <a href="/a-propos" class="btn-outline mt-8 !border-navy !text-navy hover:!bg-navy hover:!text-cream">
          Mon histoire complète →
        </a>
      </div>

      <div class="order-1 lg:order-2">
        <Image
          src={squatDay}
          alt="Alassane à l'entraînement, squat explosif en extérieur"
          class="aspect-[4/5] w-full rounded-2xl object-cover shadow-xl shadow-navy/20 ring-1 ring-navy/10"
          widths={[400, 700, 1000]}
          sizes="(max-width: 1024px) 100vw, 50vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ===================== NEWSLETTER ===================== -->
  <Newsletter
    title="Des méthodes concrètes. Directement dans ta boîte."
    subtitle="Pas de bullshit. Pas de spam. Juste ce que j'applique sur le terrain — et ce qui fonctionne vraiment."
  />
</BaseLayout>
